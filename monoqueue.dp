#include <bits/stdc++.h>
using namespace std;

using ll = long long;
const ll INF = 4e18;

/*
    Monotonic Queue DP

    Used when transition is:

        dp[i] = min(dp[j] + cost[j])
               for j in [i-k, i-1]

    Maintain deque such that:
        cost values are increasing.

    Time:  O(n)
    Space: O(n)
*/

void solve() {
    int n, k;
    cin >> n >> k;

    vector<ll> a(n), dp(n);

    for (auto &x : a) cin >> x;

    deque<int> dq;

    dp[0] = a[0];
    dq.push_back(0);

    for (int i = 1; i < n; i++) {

        // Remove indices outside the window
        while (!dq.empty() && dq.front() < i - k)
            dq.pop_front();

        // Best previous state
        dp[i] = a[i] + dp[dq.front()];

        // Maintain increasing dp values
        while (!dq.empty() && dp[dq.back()] >= dp[i])
            dq.pop_back();

        dq.push_back(i);
    }

    cout << dp[n - 1] << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    // cin >> t;

    while (t--) {
        solve();
    }

    return 0;
}